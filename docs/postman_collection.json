{
  "info": {
    "_postman_id": "a9183427-4632-4112-9850-8b067a9cf518",
    "name": "Library Management System API",
    "description": "Comprehensive Postman collection for the Library Management System API covering Auth, Users, Genres CRUD, and Books catalog with filtering, search, and role-based access control.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "librarianToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Patron)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@example.com\",\n  \"name\": \"John Doe\",\n  \"password\": \"Password123!\",\n  \"role\": \"PATRON\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new patron account and returns user details with a JWT access token."
          }
        },
        {
          "name": "Register (Librarian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"name\": \"Jane Smith\",\n  \"password\": \"LibrarianPass123!\",\n  \"role\": \"LIBRARIAN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new librarian account with LIBRARIAN role privileges."
          }
        },
        {
          "name": "Login (Patron)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"patron@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates a patron user and returns a signed JWT access token. Rate-limited via @nestjs/throttler."
          }
        },
        {
          "name": "Login (Librarian)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"librarian@example.com\",\n  \"password\": \"LibrarianPass123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates a librarian user. Rate-limited via @nestjs/throttler."
          }
        }
      ]
    },
    {
      "name": "Users (Stretch)",
      "item": [
        {
          "name": "Get Current User Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/profile",
              "host": ["{{baseUrl}}"],
              "path": ["users", "profile"]
            },
            "description": "Reads the authenticated user payload from req.user via the JWT Auth Guard."
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Cyberpunk & Dystopia\",\n  \"description\": \"Speculative fiction exploring high-tech, low-life futures.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Creates a new genre with validated DTO input."
          }
        },
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres",
              "host": ["{{baseUrl}}"],
              "path": ["genres"]
            },
            "description": "Retrieves all genres along with book counts."
          }
        },
        {
          "name": "Get Genre by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/1",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "1"]
            },
            "description": "Retrieves a single genre by ID along with its associated books."
          }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"Updated genre description with enriched catalog details.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/genres/1",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "1"]
            },
            "description": "Updates an existing genre's name or description."
          }
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/genres/1",
              "host": ["{{baseUrl}}"],
              "path": ["genres", "1"]
            },
            "description": "Deletes a genre by ID."
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books (Filtered & Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?genreId=1&search=Dune&page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                {
                  "key": "genreId",
                  "value": "1",
                  "description": "Filter books by Genre ID"
                },
                {
                  "key": "search",
                  "value": "Dune",
                  "description": "Search keyword matching title or author (case-insensitive)"
                },
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number (1-based)"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Number of books per page"
                }
              ]
            },
            "description": "Retrieves books with query-based filtering by genreId, case-insensitive title/author search, and skip/take pagination."
          }
        },
        {
          "name": "Get Book by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            },
            "description": "Retrieves a single book with its genre relation and reviews."
          }
        },
        {
          "name": "Create Book (Librarian Only - Guarded)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Snow Crash\",\n  \"author\": \"Neal Stephenson\",\n  \"isbn\": \"978-0553380958\",\n  \"totalCopies\": 5,\n  \"genreId\": 2,\n  \"publishedYear\": 1992\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books",
              "host": ["{{baseUrl}}"],
              "path": ["books"]
            },
            "description": "Guarded endpoint creating a book. Requires valid JWT with LIBRARIAN role and class-validator validated DTO."
          }
        },
        {
          "name": "Update Book (Librarian Only - Guarded)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"totalCopies\": 8,\n  \"title\": \"Snow Crash (Special Edition)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            },
            "description": "Guarded endpoint updating book attributes. Requires LIBRARIAN role."
          }
        },
        {
          "name": "Delete Book (Librarian Only - Guarded)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{librarianToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/books/1",
              "host": ["{{baseUrl}}"],
              "path": ["books", "1"]
            },
            "description": "Guarded endpoint deleting a book by ID. Requires LIBRARIAN role."
          }
        }
      ]
    }
  ]
}

