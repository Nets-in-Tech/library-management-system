{
  "name": "library-management-system",
  "version": "1.0.0",
  "description": "Library Management System - NestJS, Prisma, and PostgreSQL Data Layer",
  "main": "dist/api/src/main.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node api/src/main.ts",
    "start:dev": "ts-node api/src/main.ts",
    "prisma:generate": "prisma generate --schema=api/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=api/prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema=api/prisma/schema.prisma",
    "prisma:seed": "ts-node api/prisma/seed.ts"
  },
  "prisma": {
    "schema": "api/prisma/schema.prisma",
    "seed": "ts-node api/prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^5.1.2",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^20.11.0",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
